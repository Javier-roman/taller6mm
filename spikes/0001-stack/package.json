{
  "name": "@taller6mm/spike-0001-stack",
  "private": true,
  "description": "Spike S1 (ADR-0001): Astro 7 + Cloudflare + React 19, D1 con Drizzle, isla R3F y Better Auth. Desechable: no se fusiona.",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "lint": "biome check .",
    "typecheck": "wrangler types && astro check",
    "measure": "node scripts/measure.mjs",
    "auth:flow": "node scripts/auth-flow.mjs",
    "auth:flow:tx": "node scripts/auth-flow.mjs --tx",
    "d1:tx": "node scripts/d1-tx-probe.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.3",
    "@astrojs/react": "7.1.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "astro": "7.4.3",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "postprocessing": "6.39.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "wrangler": "4.154.0"
  }
}
