{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm verify)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm build)",
      "Bash(pnpm size)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff --staged)",
      "Bash(git diff --stat)",
      "Bash(git log --oneline *)",
      "Bash(git branch)",
      "PowerShell(pnpm verify)",
      "PowerShell(pnpm lint)",
      "PowerShell(pnpm lint *)",
      "PowerShell(pnpm typecheck)",
      "PowerShell(pnpm test)",
      "PowerShell(pnpm test *)",
      "PowerShell(pnpm build)",
      "PowerShell(pnpm size)",
      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git diff)",
      "PowerShell(git diff --staged)",
      "PowerShell(git diff --stat)",
      "PowerShell(git log --oneline *)",
      "PowerShell(git branch)"
    ],
    "ask": ["Edit(./.mcp.json)", "Edit(./.git/**)"],
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.env.test)",
      "Read(./**/.env.*.local)",
      "Read(./**/.dev.vars.staging)",
      "Read(~/.ssh/**)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.config/gh/**)",
      "Read(~/AppData/Roaming/GitHub CLI/**)",
      "Read(~/.wrangler/**)",
      "Read(~/AppData/Roaming/xdg.config/.wrangler/**)",
      "Read(~/.config/.wrangler/**)",
      "mcp__playwright__browser_file_upload",
      "mcp__playwright__browser_run_code_unsafe",
      "Read(./**/.dev.vars)",
      "Read(./**/.dev.vars.local)",
      "Read(./**/.dev.vars.preview)",
      "Read(./**/.dev.vars.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Edit(./**/.dev.vars)",
      "Edit(./**/.dev.vars.preview)",
      "Edit(./**/.dev.vars.production)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check-env.mjs"],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-shell.mjs"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__playwright__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-mcp.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format.mjs"],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
