# Finales de línea LF en el repositorio, también al trabajar desde Windows.
* text=auto eol=lf

# Scripts nativos de Windows con CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binarios.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.woff2 binary
*.glb binary
*.ktx2 binary
*.wasm binary
