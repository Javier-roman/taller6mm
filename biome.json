{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/*.md",
      "!**/worker-configuration.d.ts",
      "!**/migrations/*/meta",
      "!**/.astro",
      "!**/dist",
      "!apps/pipeline/.venv",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "jsxQuoteStyle": "double", "trailingCommas": "all", "semicolons": "always" }
  },
  "json": { "formatter": { "trailingCommas": "none" } },
  "html": {
    "experimentalFullSupportEnabled": true
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error", "noConsole": "off" },
      "style": { "useNodejsImportProtocol": "error", "noNonNullAssertion": "error" },
      "correctness": { "noUnusedImports": "error", "noUnusedVariables": "error" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["packages/domain/src/currency.ts"],
      "formatter": { "lineWidth": 140 }
    }
  ]
}
