# Dependencias y artefactos de build
node_modules/
dist/
build/
.astro/
.wrangler/
.turbo/
.cache/
coverage/
playwright-report/
test-results/
.lighthouseci/
# Modelos de desarrollo del visor de prueba (se generan con apps/web/scripts/prototipos/visor-preparar.mjs; T0, no publicables)
apps/web/public/dev/

# Salida del MCP de Playwright (instantáneas, capturas sin nombre, consola)
.playwright-mcp/

# Python (apps/pipeline)
.venv/
__pycache__/
*.pyc

# Secretos: nunca al repositorio
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key
*.p12
*.pfx
.npmrc
.netrc

# Assets fuente pesados: viven en R2 privado; en git solo el manifiesto con hashes
assets-src/**/*.blend
assets-src/**/*.blend1
assets-src/raw/
# Biblioteca de materiales CC0 descargada (en git solo catalogo/materiales-cc0.json con hashes)
assets-src/materiales-cc0/

# Capturas de referencia de terceros: uso interno, no publicar
docs/referencias/*.png
docs/referencias/*.jpg
docs/referencias/*.webp

# Sistema y editores
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code: configuración personal y local
.claude/settings.local.json
CLAUDE.local.md
# Tipos generados por `wrangler types` (se regeneran en typecheck)
worker-configuration.d.ts

# Python (apps/pipeline): versión fijada para uv
!apps/pipeline/.python-version

# Salidas de Playwright y Lighthouse por app
**/test-results/
**/playwright-report/

# Muestras generadas por las familias paramétricas (apps/pipeline)
apps/pipeline/salida/
# Copias de trabajo de los subagentes (git worktree)
.claude/worktrees/

# Cola e historial del bucle de calidad (apps/pipeline/calidad): estado local de trabajo
assets-src/calidad/

# Vistas de la escalera de calidad (apps/pipeline): renders de revision interna, nunca se publican
assets-src/vistas/
