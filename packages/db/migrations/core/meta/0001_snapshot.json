        "dimensions_nonnegative_ck": {
          "name": "dimensions_nonnegative_ck",
          "value": "(\"dimensions\".\"value\" IS NULL OR \"dimensions\".\"value\" >= 0) AND (\"dimensions\".\"value_min\" IS NULL OR \"dimensions\".\"value_min\" >= 0) AND (\"dimensions\".\"value_max\" IS NULL OR \"dimensions\".\"value_max\" >= 0)"
        },
        "dimensions_honest_ck": {
          "name": "dimensions_honest_ck",
          "value": "(\"dimensions\".\"status\" = 'pending' AND \"dimensions\".\"value\" IS NULL AND \"dimensions\".\"value_min\" IS NULL AND \"dimensions\".\"value_max\" IS NULL AND \"dimensions\".\"confidence\" IS NULL AND \"dimensions\".\"checked_on\" IS NULL AND json_array_length(\"dimensions\".\"sources\") = 0)\n        OR (\"dimensions\".\"status\" <> 'pending' AND (\"dimensions\".\"value\" IS NOT NULL OR \"dimensions\".\"value_min\" IS NOT NULL OR \"dimensions\".\"value_max\" IS NOT NULL) AND \"dimensions\".\"confidence\" IS NOT NULL AND \"dimensions\".\"checked_on\" IS NOT NULL AND json_array_length(\"dimensions\".\"sources\") > 0)"
        },
        "dimensions_range_ck": {
          "name": "dimensions_range_ck",
          "value": "\"dimensions\".\"value_min\" IS NULL OR \"dimensions\".\"value_max\" IS NULL OR \"dimensions\".\"value_min\" <= \"dimensions\".\"value_max\""
