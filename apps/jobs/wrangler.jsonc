{
  // Worker `jobs` (S3, ADR-0008): API interna de ingesta firmada (HMAC), consumidor de la cola de
  // ingesta y trabajos programados (docs/07 §6). Entornos:
  // - local (nivel superior): `wrangler dev` y tests con el pool de Workers.
  // - preview: `taller6mm-jobs-preview`, desplegado desde `main` (los PR no tienen Preview de jobs:
  //   las colas y los crons no apuntan a Previews).
  // - production: configurado y cerrado hasta el lanzamiento.
  // El consumidor de la cola y el cron se declaran junto con sus manejadores (Fase 4; docs/07 §6):
  // declararlos antes haría que Cloudflare invocase `queue()` y `scheduled()`, que aún no existen.
  // Será un solo cron cada 15 min por entorno y el manejador decidirá qué trabajos tocan (ADR-0008).
  // Bindings mínimos: solo D1. La cola de ingesta llega con su productor y su consumidor (Fase 4).
  // Ids de preview: los de `wrangler d1 create` (03-11-2026). Los PENDIENTE_* de producción, en el lanzamiento.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "taller6mm-jobs",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "preview": {
      "name": "taller6mm-jobs-preview",
      // Sin workers.dev tampoco en preview (modelo de amenazas: endpoints internos no expuestos). Cómo
      // llegará la ingesta firmada desde GitHub Actions se decide en la Fase 4 (ruta propia o Access).
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      "vars": { "ENVIRONMENT": "preview" },
      "d1_databases": [
        {
          "binding": "CORE",
          "database_name": "taller6mm-core-preview",
          "database_id": "48fcb078-0320-410d-b892-b59a10c6a3b1",
          "migrations_dir": "../../packages/db/migrations/core"
        },
        {
          "binding": "MERCADO",
          "database_name": "taller6mm-mercado-preview",
          "database_id": "caa911ae-7817-4cc8-8142-256401719a00",
          "migrations_dir": "../../packages/db/migrations/mercado"
        },
        {
          "binding": "BUSQUEDA",
          "database_name": "taller6mm-busqueda-preview",
          "database_id": "34608602-ded8-47a6-bcb5-0fee56b21518",
          "migrations_dir": "../../packages/db/migrations/busqueda"
        }
      ]
    },
    "production": {
      "name": "taller6mm-jobs",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      "vars": { "ENVIRONMENT": "production" },
      "d1_databases": [
        {
          "binding": "CORE",
          "database_name": "taller6mm-core",
          "database_id": "PENDIENTE_ID_D1_CORE",
          "migrations_dir": "../../packages/db/migrations/core"
        },
        {
          "binding": "MERCADO",
          "database_name": "taller6mm-mercado",
          "database_id": "PENDIENTE_ID_D1_MERCADO",
          "migrations_dir": "../../packages/db/migrations/mercado"
        },
        {
          "binding": "BUSQUEDA",
          "database_name": "taller6mm-busqueda",
          "database_id": "PENDIENTE_ID_D1_BUSQUEDA",
          "migrations_dir": "../../packages/db/migrations/busqueda"
        }
      ]
    }
  }
}
