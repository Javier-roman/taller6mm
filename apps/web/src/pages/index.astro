---
// Inicio: La Armería (docs/02 §3, ADR-0002). Prerenderizada: el póster y la navegación llegan en el HTML
// inicial (LCP y SEO); la isla se hidrata en reposo y, en los siguientes pasos de la Fase 1, añade por
// encima el nivel B (2,5D) y el A (3D) con caída automática al póster.
import { BRAND } from '@taller6mm/ui/brand';
import Armeria from '../components/armeria/Armeria.tsx';
import Base from '../layouts/Base.astro';

export const prerender = true;
---

