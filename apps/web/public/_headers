# Cabeceras de seguridad de los estáticos (no pasan por el Worker). Generado desde
# src/lib/security-headers.ts con staticHeaders("production"); un test comprueba que coinciden.
# Fuera de producción, la integración security-headers añade X-Robots-Tag al construir.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(self), gyroscope=(self), magnetometer=(), camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
