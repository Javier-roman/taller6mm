{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "globalDependencies": [".node-version", "packages/config/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["CI", "CLAUDE_CODE_REMOTE", "PLAYWRIGHT_BROWSERS_PATH", "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH"]
    },
    "size": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "lh": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
