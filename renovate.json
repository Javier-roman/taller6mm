{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate de Taller6mm (plan de la Fase 0, decisión 10). Lo activa Javi instalando la app solo en este repo.",
  "extends": ["config:best-practices", ":semanticCommitTypeAll(chore)", ":dependencyDashboard"],
  "timezone": "Europe/Madrid",
  "schedule": ["before 8am on monday"],
  "labels": ["dependencias"],
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "rangeStrategy": "pin",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["seguridad"],
    "minimumReleaseAge": null,
    "schedule": ["at any time"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versión de @playwright/mcp fijada en el lanzador (debe coincidir con el catálogo de pnpm).",
      "managerFilePatterns": ["/^\\.claude/mcp/playwright-launch\\.mjs$/"],
      "matchStrings": ["export const MCP_VERSION = '(?<currentValue>[^']+)'"],
      "depNameTemplate": "@playwright/mcp",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "gitleaks del CI (versión y checksum se cambian juntos a mano tras revisar la release).",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["GITLEAKS_VERSION: (?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "gitleaks/gitleaks",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "El pool de Workers (@cloudflare/vitest-pool-workers) solo admite Vitest ^4.1.",
      "matchPackageNames": ["vitest", "@vitest/**"],
      "allowedVersions": "<5"
    },
    {
      "description": "@astrojs/check exige TypeScript <= 6 y TS 7 aún no tiene API programática; se revisa con TS 7.1.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "@playwright/mcp va en el catálogo y en el lanzador: un único PR para los dos.",
      "matchPackageNames": ["@playwright/mcp"],
      "groupName": "playwright mcp"
    },
    { "groupName": "astro", "matchPackageNames": ["astro", "@astrojs/**"] },
    {
      "groupName": "cloudflare",
      "matchPackageNames": ["wrangler", "@cloudflare/**", "workerd", "miniflare"]
    },
    { "groupName": "react", "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"] },
    { "groupName": "drizzle", "matchPackageNames": ["drizzle-orm", "drizzle-kit"] },
    {
      "groupName": "pruebas",
      "matchPackageNames": [
        "vitest",
        "fast-check",
        "@playwright/test",
        "@axe-core/playwright",
        "size-limit",
        "@size-limit/**"
      ]
    },
    { "groupName": "acciones de GitHub", "matchManagers": ["github-actions"] },
    { "groupName": "python", "matchManagers": ["pep621"] },
    {
      "description": "Las versiones mayores esperan a que Javi las apruebe desde el panel de dependencias.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
